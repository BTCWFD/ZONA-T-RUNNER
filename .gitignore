# ===============================
# ZONA T RUNNER — Unity .gitignore
# ===============================

# ---- Unity Generated ----
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# ---- IDE ----
/.idea/
/.vs/
/.vscode/
*.csproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini
*.crdownload

# ---- Unity Asset Meta ----
*.pidb.meta
*.pdb.meta
*.mdb.meta

# ---- Builds ----
*.apk
*.aab
*.unitypackage
*.app
*.ipa

# ---- Crashlytics ----
crashlytics-build.properties
sysinfo.txt

# ---- Addressables ----
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# ---- TextMeshPro (generated) ----
/[Aa]ssets/TextMesh Pro/

# ---- Packages lock ----
# Keep packages-lock.json in version control
!/[Pp]ackages/packages-lock.json

# ---- Environment / Secrets ----
*.env
*.env.local
.env.*
secrets/
